{
  "id": "pr-workflow",
  "role": "feature",
  "version": "0.2.0",
  "title": "PR workflow",
  "description": "Reports PR/check status via gh into PR.md; advisory ship:pre gate on it.",
  "tier": "full",
  "requires": [],
  "engines": {
    "gsd": ">=1.6.0"
  },
  "runtimeCompat": {
    "supported": [
      "*"
    ],
    "unsupported": []
  },
  "skills": [
    "pr-workflow-report"
  ],
  "agents": [],
  "hooks": [],
  "config": {
    "pr-workflow.enabled": {
      "type": "boolean",
      "default": true,
      "description": "Master toggle for the pr-workflow capability."
    },
    "pr-workflow.ship_gate": {
      "type": "boolean",
      "default": true,
      "description": "Register the advisory ship:pre gate on PR.md."
    }
  },
  "steps": [
    {
      "point": "execute:wave:post",
      "ref": {
        "skill": "pr-workflow-report"
      },
      "produces": [
        "PR.md"
      ],
      "consumes": [],
      "when": "pr-workflow.enabled",
      "onError": "skip"
    },
    {
      "point": "ship:post",
      "ref": {
        "skill": "pr-workflow-report"
      },
      "produces": [],
      "consumes": [],
      "when": "pr-workflow.enabled",
      "onError": "skip"
    }
  ],
  "contributions": [],
  "gates": [
    {
      "point": "ship:pre",
      "check": {
        "predicate": {
          "kind": "artifact-frontmatter-equals",
          "artifact": "PR.md",
          "field": "pr_gate_ok",
          "equals": true
        }
      },
      "when": "pr-workflow.ship_gate",
      "blocking": false,
      "onError": "skip",
      "description": "Advisory: shows a message and ship continues unless PR.md has pr_gate_ok true."
    }
  ]
}
